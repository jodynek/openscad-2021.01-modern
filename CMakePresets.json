{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64-msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_INSTALL_OPTIONS": "--clean-after-build",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "CMAKE_CXX_FLAGS": "/EHsc /permissive- /bigobj /Zc:wchar_t /DNOMINMAX /D_CRT_SECURE_NO_WARNINGS /D_CRT_NONSTDC_NO_DEPRECATE /D_SCL_SECURE_NO_WARNINGS /DYY_NO_UNISTD_H /wd4503 /wd4800 /wd4100",
        "EXPERIMENTAL": "OFF",
        "SNAPSHOT": "OFF",
        "FLEX_EXECUTABLE": "${sourceDir}/tools/winflexbison/win_flex.exe",
        "BISON_EXECUTABLE": "${sourceDir}/tools/winflexbison/win_bison.exe",
        "ENABLE_TESTS": "OFF",
        "HEADLESS": "ON",
        "OPENSCAD_VERSION": "2021.01"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-headless",
      "displayName": "x64 Headless Release (command-line openscad.exe, no Qt)",
      "inherits": "x64-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-headless-debug",
      "displayName": "x64 Headless Debug",
      "inherits": "x64-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-gui",
      "displayName": "x64 GUI Release (Qt 6, needs QT6_ROOT)",
      "inherits": "x64-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HEADLESS": "OFF",
        "QT6_ROOT": "$env{QT6_ROOT}"
      }
    },
    {
      "name": "x64-gui-debug",
      "displayName": "x64 GUI Debug (Qt 6, needs QT6_ROOT)",
      "inherits": "x64-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HEADLESS": "OFF",
        "QT6_ROOT": "$env{QT6_ROOT}"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "OPENSCAD_VERSION": "2021.01",
        "ENABLE_TESTS": "OFF",
        "CMAKE_CXX_FLAGS": "-Wall"
      }
    },
    {
      "name": "linux-headless",
      "displayName": "Linux Headless Release (system packages, no Qt)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HEADLESS": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux GUI Release (system Qt 6 + QScintilla)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HEADLESS": "OFF"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux GUI Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HEADLESS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-headless",
      "configurePreset": "x64-headless"
    },
    {
      "name": "x64-headless-debug",
      "configurePreset": "x64-headless-debug"
    },
    {
      "name": "x64-gui",
      "configurePreset": "x64-gui"
    },
    {
      "name": "x64-gui-debug",
      "configurePreset": "x64-gui-debug"
    },
    {
      "name": "linux-headless",
      "configurePreset": "linux-headless"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    }
  ]
}
